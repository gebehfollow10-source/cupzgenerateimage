# Gemini API key — keep this on the server
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model that can generate images.
# Change it if your Google AI account exposes another image model.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Gemini text model for prompt enhancement
GEMINI_TEXT_MODEL=gemini-3.6-flash

PORT=3000